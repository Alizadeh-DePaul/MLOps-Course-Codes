# --- Exercise solutions (instructor-only, kept locally, not pushed) ----------
Exercises-Solutions/
.backups/
# --- ML experiment tracking artifacts ----------------------------------------
mlartifacts/
mlruns/
/wandb/
outputs/           # Hydra run-scoped output folders (per-exercise)
multirun/          # Hydra --multirun output folders

# --- DVC artifacts (UsingGCPData / DataVersionControl) -----------------------
# The .dvc/config file IS tracked (it documents the remote); the cache and
# temp folders are not. data.dvc (the pointer) IS tracked.
.dvc/cache/
.dvc/tmp/

# --- GCP service-account keys (never commit) ---------------------------------
# Pattern A in UsingGCPData uses keyless attached service accounts on VMs.
# Pattern B (downloaded JSON key) is discouraged but supported; if you do
# create a key file, it MUST stay out of git.
*-service-account*.json
*-sa.json
sa-key.json
gcp-credentials.json

# --- Profiler artifacts (per-exercise PerformanceProfiling) ------------------
*.prof             # cProfile dumps (e.g. vae.prof)
log/               # tensorboard_trace_handler output (.pt.trace.json)
profiler/          # generic profiler-output catch-all
trace.json         # export_chrome_trace output

# --- Per-exercise downloaded datasets (PythonUnitTesting downloads MNIST) ----
Exercises/PythonUnitTesting/data/

# --- API and Requests exercise (step 3 downloads a PNG into the folder) ------
Exercises/ApiAndRequests/img.png

# --- FastAPI Application exercise (endpoints write files at runtime) ----------
# /cv_model/ writes image.jpg + image_resize.jpg; /login/ writes database.csv.
# Match them anywhere under the exercise folder (root or app/).
Exercises/FastAPIApplication/**/image.jpg
Exercises/FastAPIApplication/**/image_resize.jpg
Exercises/FastAPIApplication/**/database.csv
Exercises/FastAPIApplication/image.jpg
Exercises/FastAPIApplication/image_resize.jpg
Exercises/FastAPIApplication/database.csv

# --- Streamlit / HF deployment artifacts (StreamlitHuggingFace exercise) -----
# Trained PyTorch weights are committed separately to the HF Space, not to git.
*.pth
# Streamlit Cloud / HF Spaces local secrets file.
.streamlit/secrets.toml
# CIFAR-10 dataset downloaded by train_model.py.
Exercises/StreamlitHuggingFace/data/

# --- Python / tooling --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/

# --- IDEs --------------------------------------------------------------------
.idea/
*.swp

# Ignore personal .vscode/ at the repo root only. At subdirectory levels,
# .vscode/ is allowed — specifically, per-exercise pre-wired course configs
# under Exercises/<Name>/.vscode/ ARE tracked so students get a F5-ready
# debugger out of a fresh clone.
/.vscode/

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
