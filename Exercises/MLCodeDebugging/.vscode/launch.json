{
    "// note": "Uses ${fileDirname} for cwd and ${file} for program, so these configs work whether you open MLOps-Course-Codes/ as the workspace or just Exercises/MLCodeDebugging/.",
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug current file (justMyCode)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${fileDirname}",
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Debug current file (step into PyTorch internals)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${fileDirname}",
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        }
    ]
}
